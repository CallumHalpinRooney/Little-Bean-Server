# ── Lonrú Design — environment variables ────────────────────────────────────
# Copy to `.env.local` for local dev, and add each to Netlify
# (Site settings → Environment variables) for deploys.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets there.

# Site URL — used to build Stripe success/cancel redirect URLs.
SITE_URL=http://localhost:3000

# ── Stripe ───────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret — Dashboard → Developers → Webhooks → your endpoint.
# Endpoint URL: https://YOUR_SITE/.netlify/functions/stripe-webhook
# Listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Printful ─────────────────────────────────────────────────────────────────
# Printful → Settings → API (use a private token for a single store).
PRINTFUL_API_KEY=xxx
# Optional: required if your token has access to multiple stores.
PRINTFUL_STORE_ID=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — SERVER ONLY. Used by Netlify functions + the seed script.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Cloudinary ───────────────────────────────────────────────────────────────
# Only the cloud name is needed for delivery URLs (public).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Ops (optional) ───────────────────────────────────────────────────────────
# Shared secret protecting the printful-sync function (?key=… or x-sync-key).
SYNC_SECRET=
# Slack/Discord-style incoming webhook for paid-but-unfulfilled alerts.
ALERT_WEBHOOK_URL=
